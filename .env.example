# ============================================================
# .env  —  Environment variables for RecruitAI
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file and rename it to exactly:  .env
#   2. Replace the placeholder below with your real key
#   3. Save the file — the app reads it automatically on startup
#
# Get a FREE Groq API key (no credit card needed):
#   https://console.groq.com  → sign up → API Keys → Create API Key
# ============================================================

GROQ_API_KEY=your_groq_api_key_here
